// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RESPONDER
  REVIEWER
  TEAM_MEMBER
}

enum ProjectStatus {
  ACTIVE
  PENDING
  COMPLETED
}

enum QuestionnaireStatus {
  UPLOADING
  PROCESSING
  PROCESSED
  FAILED
}

enum QuestionStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  REJECTED
}

enum NotificationType {
  ASSIGNMENT
  MENTION
  REVIEW
  SYSTEM
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  members   Member[]
  questions Question[]
  projects  Project[]

  @@map("organizations")
}

model Member {
  id             String       @id @default(cuid())
  supabaseUserId String       @unique @map("supabase_user_id")
  email          String
  name           String
  role           Role         @default(TEAM_MEMBER)
  avatarUrl      String?      @map("avatar_url")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  assignedQuestions      Question[]        @relation("AssignedQuestions")
  createdQuestions       Question[]        @relation("CreatedQuestions")
  comments               QuestionComment[]
  notifications          Notification[]
  createdProjects        Project[]         @relation("CreatedProjects")
  uploadedQuestionnaires Questionnaire[]   @relation("UploadedQuestionnaires")

  @@unique([email, organizationId])
  @@map("members")
}

model Project {
  id             String        @id @default(cuid())
  name           String
  client         String
  deadline       DateTime?
  status         ProjectStatus @default(PENDING)
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?       @map("created_by_id")
  createdBy      Member?       @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: SetNull)
  questionnaires Questionnaire[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("projects")
}

model Questionnaire {
  id            String              @id @default(cuid())
  fileName      String              @map("file_name")
  fileUrl       String              @map("file_url")
  fileSize      Int                 @map("file_size")
  fileType      String              @map("file_type")
  status        QuestionnaireStatus @default(UPLOADING)
  questionCount Int                 @default(0) @map("question_count")
  projectId     String              @map("project_id")
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById  String?             @map("uploaded_by_id")
  uploadedBy    Member?             @relation("UploadedQuestionnaires", fields: [uploadedById], references: [id], onDelete: SetNull)
  questions     Question[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("questionnaires")
}

model Question {
  id               String           @id @default(cuid())
  question         String
  draftAnswer      String?          @map("draft_answer")
  status           QuestionStatus   @default(TODO)
  confidence       Int?
  sourceFile       String?          @map("source_file")
  questionnaireId  String?          @map("questionnaire_id")
  questionnaire    Questionnaire?   @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  assignedToId     String?          @map("assigned_to_id")
  assignedTo       Member?          @relation("AssignedQuestions", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById      String?          @map("created_by_id")
  createdBy        Member?          @relation("CreatedQuestions", fields: [createdById], references: [id], onDelete: SetNull)
  responseDueAt    DateTime?        @map("response_due_at")
  deadlineReminderSentAt DateTime? @map("deadline_reminder_sent_at")
  organizationId   String           @map("organization_id")
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  comments         QuestionComment[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("questions")
}

model QuestionComment {
  id          String   @id @default(cuid())
  questionId  String   @map("question_id")
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId    String   @map("author_id")
  author      Member   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text        String
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("question_comments")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String           @map("recipient_id")
  recipient   Member           @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  data        Json             @default("{}")
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("notifications")
}
